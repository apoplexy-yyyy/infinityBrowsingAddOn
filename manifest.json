{
  "manifest_version": 3,
  "name": "Infinite Zoom Browser",
  "version": "1.0.0",
  "description": "スクロールアップで拡大すると、リンクの中にリンク先が現れ、どこまでも入っていけるブラウザ拡張。移動はドラッグ。",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "このページを無限ズームで開く" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
